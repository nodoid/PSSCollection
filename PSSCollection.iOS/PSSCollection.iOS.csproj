<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <!-- iOS 18 and later, as required for the collection. -->
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.allthejohnsons.psscollection</ApplicationId>
    <ApplicationTitle>The PSS Oric Collection</ApplicationTitle>
    <ApplicationVersion>$(BuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <RootNamespace>PSSCollection.iOS</RootNamespace>
    <AssemblyName>PSSCollection</AssemblyName>
    <AppIcon>AppIcon</AppIcon>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <!-- Profiles live in ~/Downloads and are installed locally by tools/build_release.sh. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodesignKey>Apple Development: Created via API (ZTRSB8B479)</CodesignKey>
    <CodesignProvision>devel-pss</CodesignProvision>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>Apple Distribution: Paul Johnson (3UH7BE38T3)</CodesignKey>
    <CodesignProvision>rel-pss</CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <BuildIpa>true</BuildIpa>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PSSCollection.Core\PSSCollection.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <BundleResource Include="AppIcon.xcassets\**\*" />
  </ItemGroup>
</Project>

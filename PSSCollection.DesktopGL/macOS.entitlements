<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store apps must run inside the App Sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- The CoreCLR just-in-time compiler needs to map executable memory. App Review
         rejects allow-unsigned-executable-memory outright, and the runtime does not
         need it once allow-jit is present. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>

<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>Paul F. Johnson</Authors>
    <Copyright>© 2026 Paul F. Johnson</Copyright>
    <Product>The PSS Oric Collection</Product>
    <Description>The PSS Oric Collection - the Oric-1 / Oric Atmos arcade games from Personal Software Services, recreated in MonoGame by PFJ.</Description>
    <Version>1.0.0</Version>
    <MonoGameVersion>3.8.6.1</MonoGameVersion>
    <!-- Store build number: bump for every App Store / Play / Partner Center upload. -->
    <BuildNumber>1</BuildNumber>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
</Project>

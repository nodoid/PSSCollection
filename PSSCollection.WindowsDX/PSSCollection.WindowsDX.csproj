<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows head (DirectX). Packaged as an MSIX for the Microsoft Store / Xbox by
       tools/build_windows.sh, which runs inside the Parallels Windows VM. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <AssemblyName>PSSCollection</AssemblyName>
    <RootNamespace>PSSCollection.WindowsDX</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PSSCollection.Core\PSSCollection.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Assets\**" />
    <EmbeddedResource Include="Icon.ico" LogicalName="Icon.ico" />
    <Content Include="Package.appxmanifest" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
